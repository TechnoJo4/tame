{
	"workspace": [
		"packages/*",
		"packages/plugin-web/web",
		"packages/plugin-history/web",
		"packages/plugin-ops/web",
		"packages/plugin-projects/web"
	],
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/path": "jsr:@std/path@^1.1.6",
		"typebox": "npm:typebox@^1.3.23"
	},
	"nodeModulesDir": "auto",
	"tasks": {
		"test": "deno test --allow-read --allow-env --allow-net=127.0.0.1 packages/"
	},
	"lint": {
		"rules": {
			"exclude": ["require-await", "no-explicit-any", "no-slow-types"]
		}
	}
}
