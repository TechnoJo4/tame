{
	"type": "object",
	"required": [
		"maxLines",
		"defaultLines",
		"maxBytes",
		"maxReadBytes",
		"timeout",
		"shell",
		"defaultEnv",
		"localEnv",
		"env",
		"tools"
	],
	"properties": {
		"maxLines": {
			"type": "number",
			"default": 2000
		},
		"defaultLines": {
			"type": "number",
			"default": 200
		},
		"maxBytes": {
			"type": "number",
			"default": 51200
		},
		"maxReadBytes": {
			"type": "number",
			"default": 52428800
		},
		"timeout": {
			"type": "number",
			"default": 120000
		},
		"shell": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": [
				"bash",
				"-lc"
			]
		},
		"defaultEnv": {
			"type": "string",
			"default": "local"
		},
		"localEnv": {
			"type": "object",
			"required": [
				"workdir"
			],
			"properties": {
				"workdir": {
					"type": "string",
					"default": "."
				}
			},
			"default": {}
		},
		"env": {
			"type": "object",
			"required": [
				"static",
				"dynamic"
			],
			"properties": {
				"static": {
					"type": "object",
					"properties": {},
					"additionalProperties": {
						"type": "string"
					},
					"default": {}
				},
				"dynamic": {
					"type": "object",
					"properties": {},
					"additionalProperties": {
						"anyOf": [
							{
								"type": "string",
								"const": "MODEL"
							},
							{
								"type": "string",
								"const": "AGENT_ID"
							},
							{
								"type": "string",
								"const": "AGENT_SYSTEM"
							}
						]
					},
					"default": {}
				}
			},
			"default": {}
		},
		"tools": {
			"type": "object",
			"required": [
				"read",
				"write",
				"edit",
				"exec",
				"bash"
			],
			"properties": {
				"read": {
					"type": "boolean",
					"default": true
				},
				"write": {
					"type": "boolean",
					"default": true
				},
				"edit": {
					"type": "boolean",
					"default": true
				},
				"exec": {
					"type": "boolean",
					"default": false
				},
				"bash": {
					"type": "boolean",
					"default": true
				}
			},
			"default": {}
		}
	},
	"$schema": "https://json-schema.org/draft/2020-12/schema"
}
