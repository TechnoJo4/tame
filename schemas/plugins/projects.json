{
	"type": "object",
	"required": [
		"projects"
	],
	"properties": {
		"projects": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"name",
					"workdir",
					"files"
				],
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"workdir": {
						"type": "string",
						"minLength": 1
					},
					"files": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						},
						"default": [
							"AGENTS.md"
						]
					}
				}
			}
		}
	},
	"$schema": "https://json-schema.org/draft/2020-12/schema"
}
